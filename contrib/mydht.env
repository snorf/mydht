# /etc/default/mydht: settings for the mydht systemd service.

# The address the other nodes use to reach this one. Use an IP address or a
# DNS name that resolves on every node, never localhost.
MYDHT_HOST=192.168.1.11
MYDHT_PORT=50140

# The address to listen on. 0.0.0.0 means every interface.
MYDHT_BIND=0.0.0.0

# Every node in the cluster, comma-separated. The same line works on every
# node: a node skips itself, joins the first one that answers, and if none
# answers it starts alone and keeps retrying.
MYDHT_JOIN=192.168.1.11:50140,192.168.1.12:50140,192.168.1.13:50140

# Copies of each key. Only the first node in a new ring decides this.
MYDHT_REPLICAS=3
