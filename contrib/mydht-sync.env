# /etc/default/mydht-sync: settings for mydht-sync.timer.
# The example keeps a NextDNS hosts file in sync on three nodes.

# The key in the DHT and the local file it is written to.
MYDHT_SYNC_KEY=nextdns/hosts.conf
MYDHT_SYNC_TARGET=/etc/nextdns/hosts.conf

# Command to run after the file has changed (leave empty for none).
MYDHT_SYNC_RELOAD="systemctl restart nextdns"

# DHT nodes to ask, in order; the first one that answers is used.
MYDHT_SYNC_NODES="http://localhost:50140 http://192.168.1.11:50140 http://192.168.1.12:50140 http://192.168.1.13:50140"

# Optional: where new versions come from. Leave empty on nodes that should
# only follow the DHT.
MYDHT_SYNC_UPSTREAM=https://gitlab.com/you/dns/-/raw/main/hosts.conf

# Turns for fetching from upstream: every MYDHT_SYNC_INTERVAL minutes one
# node does it, going round the slots. Give each node its own slot
# (0, 1, 2, ...) and set MYDHT_SYNC_SLOTS to the number of nodes. With the
# values below upstream is polled every 5 minutes and each node polls it
# every 15. If a node is down, only its turn is skipped.
MYDHT_SYNC_SLOT=0
MYDHT_SYNC_SLOTS=3
MYDHT_SYNC_INTERVAL=5
